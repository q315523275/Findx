{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Urls": "http://localhost:7101",
  "Findx": {
    "Jobs": {
      "Enabled": true,
      "ScheduleType": "Distributed"
    },
    "FreeSql": {
      "Enabled": false
    },
    "Scheduler": {
      "NodeName": "scheduler-worker-1",
      "NodeAddress": "http://localhost:7101",
      "SchedulerEnabled": false,
      "WorkerEnabled": true,
      "ClusterToken": "findx-demo-token",
      "MasterEndpoints": [
        "http://localhost:7100"
      ],
      "WorkerHeartbeatIntervalSeconds": 10,
      "CapabilityRefreshSeconds": 60,
      "LogShipBatchSize": 20,
      "LogShipIntervalMs": 2000,
      "LogMaskingEnabled": false
    }
  }
}
