<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>default</LangVersion>
        <RootNamespace>Findx.Samples.SchedulerServer</RootNamespace>
        <AssemblyName>Findx.Samples.SchedulerServer</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\components\Findx.Extensions.Scheduler\Findx.Extensions.Scheduler.csproj" />
        <ProjectReference Include="..\..\framework\Findx.AspNetCore\Findx.AspNetCore.csproj" />
        <ProjectReference Include="..\..\framework\Findx.FreeSql\Findx.FreeSql.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- 调度端要读写调度库；MySQL 提供程序只在服务端需要 -->
        <PackageReference Include="FreeSql.Provider.MySqlConnector" Version="3.5.311" />
    </ItemGroup>

</Project>
