{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Urls": "http://localhost:7100",
  "Findx": {
    "Jobs": {
      "Enabled": true,
      "ScheduleType": "Distributed"
    },
    "FreeSql": {
      "Enabled": true,
      "Primary": "jobs",
      "Strict": false,
      "DataSource": {
        "jobs": {
          "ConnectionString": "Data Source=127.0.0.1;Port=3306;User ID=root;Password=123456;Initial Catalog=findx_scheduler_demo;Charset=utf8mb4;SslMode=none;Min pool size=1",
          "DbType": "MySql",
          "UseAutoSyncStructure": true,
          "PrintSql": false
        }
      }
    },
    "Scheduler": {
      "NodeName": "scheduler-server-1",
      "NodeAddress": "http://localhost:7100",
      "SchedulerEnabled": true,
      "WorkerEnabled": false,
      "ClusterToken": "findx-demo-token",
      "MasterEndpoints": [],
      "MasterLockTtlSeconds": 15,
      "WorkerHeartbeatTtlSeconds": 45,
      "WorkerHeartbeatIntervalSeconds": 10,
      "CapabilityRefreshSeconds": 60,
      "SchedulerScanIntervalSeconds": 5,
      "MaxRetryCount": 2,
      "RetryBaseDelayMs": 1000,
      "RetryMaxDelayMs": 5000,
      "LookaheadWindowSeconds": 60,
      "LookaheadRefreshSeconds": 30,
      "ExecutionTimeoutMinutes": 10,
      "DeadLetterEnabled": true,
      "DispatchStrategy": "RoundRobin",
      "LogMaskingEnabled": false,
      "RetentionDays": 7
    },
    "Samples": {
      "SeedDemoJobs": true
    }
  }
}
